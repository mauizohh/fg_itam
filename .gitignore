# Dependencies
/node_modules
/vendor

# Environment & Secrets
.env
.env.backup
.env.production
.env.*.local

# Compiled Assets & Build Artifacts
/public/build
/public/hot
/public/storage

# Laravel Runtime Storage
/storage/*.key
/storage/app/*
!/storage/app/public/
/storage/app/public/*
